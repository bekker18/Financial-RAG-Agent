# Groq LLM
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini embeddings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# SEC requires a declared User-Agent for scripted access
SEC_USER_AGENT=FinancialRAGAgent your_email@example.com

# Local vector database
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=financial_filings

# Chunking
CHUNK_SIZE=1800
CHUNK_OVERLAP=250